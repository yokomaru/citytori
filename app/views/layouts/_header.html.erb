<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
    <div>
      ロゴ
    </div>

    <% if logged_in? %>
      <nav>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-md text-slate-800 hover:bg-gray-100">
          <i class="fa-solid fa-bars text-2xl"></i>
        </button>

        <ul>
          <li>つかいかた</li>
          <li>散歩中に戻る</li>
          <li>今までの散歩を見る</li>
          <li><%= button_to "ログアウト", logout_path, method: :post %> </li>
          <li><%= button_to "退会", withdraw_user_path, method: :delete, data: { turbo_confirm: "退会するとこれまでの散歩の記録はすべて削除されます。退会してよろしいですか？" } %></li>
        </ul>
      </nav>
    <% else %>
      <%= button_to "Googleでログイン",
                    "/auth/google_oauth2",
                    method: :post,
                    data: { turbo: false } %>
    <% end %>
  </div>
</header>