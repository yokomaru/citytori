<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
    <%= link_to root_path class: "cursor-pointer" do %>
      <div>
        ロゴ
      </div>
    <% end %>

    <% if logged_in? %>
      <nav data-controller="header">
        <%= button_tag type: "button", data: { action: "header#toggle" }, class: "cursor-pointer flex h-10 w-10 items-center justify-center rounded-md text-slate-800 hover:bg-gray-100" do %>
          <i class="fa-solid fa-bars text-2xl"></i>
        <% end %>

        <ul data-header-target="menu" class="hidden">
          <li>つかいかた</li>
          <li>散歩中に戻る</li>
          <li>今までの散歩を見る</li>

          <li>
            <%= button_to "ログアウト", logout_path, method: :post %>
          </li>

          <li>
            <%= button_to "退会",
                          withdraw_user_path,
                          method: :delete,
                          data: {
                            turbo_confirm: "退会するとこれまでの散歩の記録はすべて削除されます。退会してよろしいですか？"
                          } %>
          </li>
        </ul>
      </nav>
    <% else %>
      <%= button_to "Googleでログイン",
                    "/auth/google_oauth2",
                    method: :post,
                    class: "cursor-pointer",
                    data: { turbo: false } %>
    <% end %>
  </div>
</header>
