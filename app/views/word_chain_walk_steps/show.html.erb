<% content_for :title, "Step詳細" %>

<div class="mx-auto w-full max-w-xl px-5 py-6 sm:px-6">
  <div class="mb-5">
    <%= link_to word_chain_walk_path(@word_chain_walk), class: "inline-flex items-center gap-1 text-sm font-medium text-slate-700 hover:text-slate-900" do %>
      <span>&lt;</span>
      <span>しりとり散歩に戻る</span>
    <% end %>
  </div>

  <header class="mb-3 text-center">
    <div class="relative mx-auto h-36 w-full">
      <div class="absolute inset-x-0 bottom-0 flex justify-center">
        <%= image_tag "citytori-street-line.png", class: "w-full opacity-90" %>
      </div>

      <div
        class="
          absolute left-1/2 top-[46%] z-10
          flex h-28 w-28
          -translate-x-1/2 -translate-y-1/2
          items-center justify-center
          rounded-2xl border border-slate-300 bg-white
        "
      >
        <span class="text-5xl font-bold text-slate-900">
          <%= @word_chain_walk_step.word.first %>
        </span>
      </div>
    </div>

    <h1 class="mt-1 text-xl font-bold text-slate-800">
      <%= @word_chain_walk_step.word %>
    </h1>
  </header>

  <div class="space-y-5">
    <section class="rounded-xl border border-slate-200 bg-white px-4 py-3">
      <h2 class="text-sm font-bold text-slate-700">
        撮った日時
      </h2>

      <p class="mt-2 text-sm text-slate-600">
        <%= @word_chain_walk_step.created_at.strftime("%Y年%-m月%-d日 %H:%M") %>
      </p>
    </section>

    <% if @word_chain_walk_step.image.attached? %>
      <section>
        <h2 class="mb-2 text-sm font-bold text-slate-700">
          撮った写真
        </h2>

        <%= image_tag @word_chain_walk_step.image.variant(resize_to_limit: [800, 800]), class: "aspect-[3/2] w-full rounded-xl object-cover" %>
      </section>
    <% end %>

    <% if @word_chain_walk_step.memo.present? %>
      <section class="rounded-xl border border-slate-200 bg-white px-3 pt-3 pb-5">
        <h2 class="mb-2 text-sm font-bold text-slate-700">
          メモ
        </h2>

        <div class="rounded-lg border border-slate-200 px-4 py-3">
          <p class="text-sm leading-relaxed text-slate-700">
            <%= @word_chain_walk_step.memo %>
          </p>
        </div>
      </section>
    <% end %>

    <% if @word_chain_walk_step.latitude.present? && @word_chain_walk_step.longitude.present? %>
      <section>
        <h2 class="mb-2 text-sm font-bold text-slate-700">
          見つけた場所
        </h2>

        <div
          data-controller="step-map"
          data-step-map-latitude-value="<%= @word_chain_walk_step.latitude %>"
          data-step-map-longitude-value="<%= @word_chain_walk_step.longitude %>"
          data-step-map-word-value="<%= @word_chain_walk_step.word %>"
          class="h-40 w-full overflow-hidden rounded-xl"
        ></div>
      </section>
    <% end %>
  </div>
</div>
