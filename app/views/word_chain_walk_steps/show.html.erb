<% if turbo_frame_request_id == "selected_walk_step" %>
  <%= turbo_frame_tag "selected_walk_step" do %>
    <%= render "word_chain_walks/finished/map_card", word_chain_walk_step: @word_chain_walk_step %>
  <% end %>
<% else %>
  <% set_meta_tags title: "記録の詳細", description: "Citytoriで記録した「#{@word_chain_walk_step.word}」の写真、メモ、位置情報を確認できます。", noindex: true %>
  <div class="walk-step-detail-page">
    <article class="walk-step-detail-sheet">
      <div class="mb-5 sm:mb-6">
        <%= link_to word_chain_walk_path(@word_chain_walk), class: "inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#204D49] bg-transparent px-4 py-2 text-sm font-medium text-[#204D49] transition-colors hover:bg-[#E8F4F5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]" do %>
          <span aria-hidden="true">←</span>
          <span>しりとり散歩に戻る</span>
        <% end %>
      </div>

      <header class="text-center">
        <div class="relative mx-auto h-40 w-full max-w-[720px] sm:h-52">
          <%= image_tag "street-line-step.png",
                        alt: "",
                        class: "absolute inset-x-0 bottom-0 w-full" %>

          <div class="absolute left-1/2 top-1/2 z-10 grid size-28 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-2xl border border-[#204D49] bg-[#FCF9EF] sm:size-36">
            <span class="text-5xl font-black leading-none text-[#204D49] sm:text-6xl">
              <%= @word_chain_walk_step.word.first %>
            </span>
          </div>
        </div>

        <h1 class="mt-3 text-2xl font-bold tracking-tight text-[#204D49] sm:mt-4 sm:text-3xl">
          <%= @word_chain_walk_step.word %>
        </h1>

        <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-[#E8F4F5] px-3 py-1.5 text-sm text-[#303B3C]">
          <i class="fa-regular fa-calendar" aria-hidden="true"></i>
          <time datetime="<%= @word_chain_walk_step.created_at.iso8601 %>">
            <%= l(@word_chain_walk_step.created_at, format: :recorded_at) %>
          </time>
        </p>
      </header>

      <div class="mt-7 space-y-7 sm:mt-9 sm:space-y-9">
        <% if @word_chain_walk_step.image.attached? %>
          <section aria-label="記録した写真">
            <%= image_tag(
                  @word_chain_walk_step.image.variant(resize_to_limit: [800, 800]),
                  alt: "見つけた「#{@word_chain_walk_step.word}」の写真",
                  class: "block w-full rounded-xl object-contain"
                ) %>
          </section>
        <% end %>

        <section class="border-t border-[#D9E4E1] pt-6">
          <h2 class="text-lg font-bold text-[#204D49]">メモ</h2>

          <% if @word_chain_walk_step.memo.present? %>
            <p class="mt-3 whitespace-pre-wrap text-[0.9375rem] leading-relaxed text-[#303B3C]">
              <%= @word_chain_walk_step.memo %>
            </p>
          <% else %>
            <p class="mt-3 text-sm text-[#667773]">メモはありません</p>
          <% end %>
        </section>

        <% if @word_chain_walk_step.latitude.present? && @word_chain_walk_step.longitude.present? %>
          <section class="border-t border-[#D9E4E1] pt-6">
            <h2 class="text-lg font-bold text-[#204D49]">見つけた場所</h2>

            <div
              data-controller="step-map"
              data-step-map-latitude-value="<%= @word_chain_walk_step.latitude %>"
              data-step-map-longitude-value="<%= @word_chain_walk_step.longitude %>"
              data-step-map-word-value="<%= @word_chain_walk_step.word %>"
              class="mt-3 h-56 w-full overflow-hidden rounded-xl border border-[#204D49]/10 sm:h-64"
            ></div>
          </section>
        <% end %>
      </div>
    </article>
  </div>
<% end %>
