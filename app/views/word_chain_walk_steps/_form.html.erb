<div id="word_chain_walk_step_errors" data-modal-target="errors">
  <%= render "shared/error_messages", object: form.object %>
</div>

<div>
  <div class="my-5">
    <div
      data-previews-target="preview"
      class="hidden mb-5 overflow-hidden rounded-md bg-gray-100"
    >
      <img
        data-previews-target="image"
        class="block max-h-72 w-full object-contain"
      >
    </div>
  </div>
</div>

<div class="my-5">
  <div>
    <%= form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
    <%= form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

    <p data-geolocation-target="status" class="mt-3 text-sm text-gray-600"></p>
    <p data-geolocation-target="position" class="text-sm text-gray-600"></p>
  </div>
</div>

<div class="my-5">
  <div class="flex items-baseline gap-2">
    <%= form.label :word, "見つけた言葉" %>
    <span class="text-xs text-gray-600">
      ※ ひらがなとのばし棒(ー)のみ入力できます
    </span>
  </div>

  <%= form.text_field :word,
                      class: [
                        "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                        {
                          "border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:word].none?,
                          "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:word].any?
                        }
                      ] ,
                      placeholder: "こーひーしょっぷ" %>
</div>

<div class="my-5">
  <%= form.label :memo, "メモ" %>

  <%= form.text_area :memo,
                      rows: 4,
                      class: [
                        "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                        {
                          "border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:memo].none?,
                          "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:memo].any?
                        }
                      ] %>
</div>

<div class="inline">
  <%= form.submit "登録する", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
</div>
