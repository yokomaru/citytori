<div id="word_chain_walk_step_errors" data-modal-target="errors">
  <%= render "shared/error_messages", object: form.object %>
</div>

<div>
  <div class="my-5">
    <div
      data-previews-target="preview"
      class="hidden mb-5 overflow-hidden rounded-md bg-gray-100"
    >
      <img
        data-previews-target="image"
        class="block max-h-72 w-full object-contain"
      >
    </div>
  </div>
</div>

<div class="my-5 text-left">
  <div>
    <%= form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
    <%= form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

    <div data-geolocation-target="loadingStatus">
      <div
        class="
          flex items-center gap-2 rounded-md border border-amber-300
          bg-amber-100 px-4 py-3 text-sm text-amber-700
        "
      >
        <i class="fa-solid fa-spinner fa-spin"></i>
        <p class="font-semibold">位置情報を確認しています…</p>
      </div>
    </div>

    <div data-geolocation-target="successStatus" hidden>
      <div
        class="
          rounded-md border border-green-300 bg-green-100 px-4 py-3 text-sm
          text-green-700
        "
      >
        <div class="flex items-start gap-2">
          <i class="fa-solid fa-circle-check mt-1"></i>

          <div>
            <p class="font-semibold">位置情報を取得できました</p>
            <p>見つけた場所も一緒に記録します</p>
          </div>
        </div>
      </div>
    </div>

    <div data-geolocation-target="failedStatus" hidden>
      <div
        class="
          rounded-md border border-gray-300 bg-gray-100 px-4 py-3 text-sm
          text-gray-700
        "
      >
        <div class="flex items-start gap-2">
          <i class="fa-solid fa-circle-exclamation"></i>

          <div>
            <p class="font-semibold">位置情報を取得できませんでした</p>
            <p>位置情報なしで登録されます</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-2 text-center">
      <%= link_to "位置情報の設定方法を見る",
                  "#",
                  class: "text-sm text-blue-600 underline" %>
    </div>
  </div>
</div>

<div class="my-5 text-left">
  <div class="flex items-baseline gap-2">
    <%= form.label :word, "見つけた言葉" %>
    <span class="text-xs text-gray-600"> ※ ひらがなとのばし棒(ー)のみ入力できます </span>
  </div>

  <%= form.text_field :word,
                      class: [
                        "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                        {
                          "border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:word].none?,
                          "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:word].any?
                        }
                      ],
                      data: { form_target: "word" }, placeholder: "こーひーしょっぷ" %>
</div>

<div class="my-5 text-left">
  <%= form.label :memo, "メモ" %>

  <%= form.text_area :memo,
                      rows: 4,
                      class: [
                        "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                        {
                          "border-gray-400 focus:outline-blue-600": word_chain_walk_step.errors[:memo].none?,
                          "border-red-400 focus:outline-red-600": word_chain_walk_step.errors[:memo].any?
                        }
                      ] %>
</div>

<div class="inline">
  <%= form.submit "登録する", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
</div>
