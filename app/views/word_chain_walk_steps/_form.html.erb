<div id="word_chain_walk_step_errors" data-modal-target="errors">
  <%= render "shared/error_messages", object: form.object %>
</div>

<div class="mt-4 sm:mt-5">
  <div
    data-previews-target="preview"
    class="hidden overflow-hidden rounded-xl border border-[#204D49]/10 bg-[#FCF9EF]"
  >
    <img
      data-previews-target="image"
      class="block max-h-80 w-full object-contain sm:max-h-[26rem]"
      alt="選択した写真のプレビュー"
    >
  </div>
</div>

<div class="mt-5 text-left">
  <div>
    <%= form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
    <%= form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

    <div data-geolocation-target="loadingStatus">
      <%= render "shared/status_notice",
                 variant: :processing,
                 title: "位置情報を確認しています…",
                 message: "見つけた場所も一緒に記録します" %>
    </div>

    <div data-geolocation-target="successStatus" hidden>
      <%= render "shared/status_notice",
                 variant: :success,
                 title: "位置情報を取得できました",
                 message: "見つけた場所も一緒に記録します" %>
    </div>

    <div data-geolocation-target="failedStatus" hidden>
      <%= render "shared/status_notice",
                 variant: :muted_failure,
                 title: "位置情報を取得できませんでした",
                 message: "位置情報なしでこのまま記録できます" %>
    </div>

    <div class="mt-2 text-center">
      <p class="text-xs leading-relaxed text-[#52645F]">
        位置情報を利用するには、ブラウザまたは端末の設定で位置情報の利用を許可してください。
      </p>
    </div>
  </div>
</div>

<% word_errors = word_chain_walk_step.errors.full_messages_for(:word) %>
<% word_error_id = "word_chain_walk_step_word_error" %>

<div class="mt-6 text-left">
  <div class="flex items-baseline gap-2">
    <%= form.label :word,
                   WordChainWalkStep.human_attribute_name(:word),
                   class: "text-base font-bold text-[#204D49]" %>
    <span class="rounded-full bg-[#FCEDEA] px-2 py-0.5 text-xs font-semibold text-[#CC491C]">必須</span>
  </div>

  <p class="mt-1 text-xs text-[#52645F]">ひらがなとのばし棒（ー）のみ入力できます</p>

  <%= form.text_field :word,
                      class: [
                        "mt-2 block w-full rounded-xl border bg-white px-4 py-3 text-base text-[#303B3C] placeholder:text-[#7A8B87] focus:outline-none focus:ring-2",
                        {
                          "border-[#B7D5D7] focus:border-[#204D49] focus:ring-[#204D49]/20": word_errors.empty?,
                          "border-[#B5473C] focus:border-[#B5473C] focus:ring-[#B5473C]/20": word_errors.any?
                        }
                      ],
                      data: { form_target: "word" },
                      placeholder: "こーひーしょっぷ",
                      aria: (word_errors.any? ? { invalid: true, describedby: word_error_id } : {}) %>

  <% if word_errors.any? %>
    <p id="<%= word_error_id %>" class="mt-2 text-sm text-[#B5473C]">
      <%= word_errors.join("、") %>
    </p>
  <% end %>
</div>

<% memo_errors = word_chain_walk_step.errors.full_messages_for(:memo) %>
<% memo_error_id = "word_chain_walk_step_memo_error" %>

<div class="mt-6 text-left">
  <div class="flex items-baseline gap-2">
    <%= form.label :memo,
                   WordChainWalkStep.human_attribute_name(:memo),
                   class: "text-base font-bold text-[#204D49]" %>
    <span class="rounded-full bg-[#F2F5F3] px-2 py-0.5 text-xs font-semibold text-[#52645F]">任意</span>
  </div>

  <%= form.text_area :memo,
                      rows: 4,
                      class: [
                        "mt-2 block w-full rounded-xl border bg-white px-4 py-3 text-base text-[#303B3C] placeholder:text-[#7A8B87] focus:outline-none focus:ring-2",
                        {
                          "border-[#B7D5D7] focus:border-[#204D49] focus:ring-[#204D49]/20": memo_errors.empty?,
                          "border-[#B5473C] focus:border-[#B5473C] focus:ring-[#B5473C]/20": memo_errors.any?
                        }
                      ],
                      placeholder: "気になったことをひとこと",
                      aria: (memo_errors.any? ? { invalid: true, describedby: memo_error_id } : {}) %>

  <% if memo_errors.any? %>
    <p id="<%= memo_error_id %>" class="mt-2 text-sm text-[#B5473C]">
      <%= memo_errors.join("、") %>
    </p>
  <% end %>
</div>

<div class="mt-7 flex flex-col gap-3 sm:flex-row">
  <%= form.submit "写真とことばを記録する", class: "min-h-12 flex-1 cursor-pointer rounded-xl bg-[#F16B36] px-4 py-3 text-[19px] font-bold text-white hover:bg-[#CC491C] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]" %>

  <button
    type="button"
    data-action="modal#close"
    class="min-h-12 flex-1 rounded-xl border border-[#204D49] bg-white px-4 py-3 text-base font-semibold text-[#204D49] hover:bg-[#E8F4F5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]"
  >
    キャンセル
  </button>
</div>
