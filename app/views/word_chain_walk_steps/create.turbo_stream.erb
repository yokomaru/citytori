<%= turbo_stream.update "latest_step" do %>
  <%= render "word_chain_walks/active/latest_step", word_chain_walk: @word_chain_walk %>
<% end %>

<%= turbo_stream.replace "word_chain_walk_target" do %>
  <%= render "word_chain_walks/active/target", word_chain_walk: @word_chain_walk %>
<% end %>

<%= turbo_stream.update "flash_messages" do %>
  <%= render "shared/flash_messages" %>
<% end %>

<%= turbo_stream.replace "word_chain_walk_modal_target" do %>
  <%= render "word_chain_walks/active/modal_target",
             word_chain_walk: @word_chain_walk %>
<% end %>
