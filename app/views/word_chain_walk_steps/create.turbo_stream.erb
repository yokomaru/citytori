<%= turbo_stream.update "word_chain_walk_steps" do %>
  <% latest_step_id = @word_chain_walk.latest_step.id %>
  <% @word_chain_walk.word_chain_walk_steps.with_attached_image.order(id: :desc).each do |word_chain_walk_step| %>
    <%= render "word_chain_walks/word_chain_walk_step",
    word_chain_walk: @word_chain_walk,
    word_chain_walk_step: word_chain_walk_step,
    latest_step_id: latest_step_id %>
  <% end %>
<% end %>
