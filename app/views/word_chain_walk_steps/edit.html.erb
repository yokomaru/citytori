<%= turbo_frame_tag dom_id(@word_chain_walk_step, :memo) do %>
  <h2 class="text-lg font-bold text-[#204D49]">メモ</h2>
  <%= form_with model: [@word_chain_walk, @word_chain_walk_step], class: "mt-3" do |form| %>
    <%= render "shared/error_messages", object: @word_chain_walk_step %>

    <%= form.label :memo, "メモを編集", class: "sr-only" %>

    <%= form.text_area :memo,
                       rows: 4,
                       placeholder: "気になったことをひとこと",
                       class: "block w-full rounded-xl border border-[#B7D5D7] bg-white px-4 py-3 text-base text-[#303B3C] placeholder:text-[#7A8B87] focus:border-[#204D49] focus:outline-none focus:ring-2 focus:ring-[#204D49]/20" %>

    <div class="mt-3 flex flex-wrap items-center justify-end gap-3">
      <%= link_to "キャンセル",
                  word_chain_walk_word_chain_walk_step_path(@word_chain_walk, @word_chain_walk_step),
                  class: "min-h-11 inline-flex items-center text-sm font-medium text-[#52645F] underline underline-offset-4 hover:text-[#204D49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]" %>

      <%= form.submit "メモを更新する", class: "min-h-11 cursor-pointer rounded-lg bg-[#B9471D] px-4 py-2 text-base font-bold text-white hover:bg-[#CC491C] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]" %>
    </div>
  <% end %>
<% end %>
