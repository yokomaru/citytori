<div class="md:w-2/3 w-full">
  <div id="flash_messages">
    <%= render "shared/flash_messages" %>
  </div>

  <div id="word_chain_walk_errors">
    <%= render "shared/error_messages", object: word_chain_walk_step %>
  </div>

  <div>
    <%= link_to "< しりとり散歩一覧へ", word_chain_walks_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h1 class="font-bold text-4xl mb-6">しりとり散歩中</h1>

  <div class="mb-6">
    <%= render "word_chain_walks/active/count", word_chain_walk_steps: word_chain_walk_steps %>
    <%= render "word_chain_walks/active/target", word_chain_walk: word_chain_walk %>
    <%= render "word_chain_walks/active/form", word_chain_walk: word_chain_walk, word_chain_walk_step: word_chain_walk_step %>

    <section class="mx-auto mt-6 max-w-xl">
      <h2 class="text-base font-bold text-gray-900">
        <i class="fa-regular fa-clock"></i>
        直前の記録
      </h2>

      <%= render "word_chain_walks/active/latest_step", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>
    </section>

    <section class="mt-5 text-center">
      <div class="mt-6 text-center">
        <%= button_to "しりとり散歩をおしまいにする", word_chain_walk_completion_path(word_chain_walk), method: :patch, class: "text-sm text-gray-500 hover:text-gray-700", data: { turbo_confirm: "しりとり散歩をおしまいにしますか？" } %>
      </div>
    </section>
  </div>
</div>
