<div class="mx-auto w-full max-w-2xl px-4 sm:px-6">
  <div id="word_chain_walk_errors">
    <%= render "shared/error_messages", object: word_chain_walk_step %>
  </div>

  <div>
    <%= link_to "< ホームへ戻る", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <header class="mt-4 text-center">
    <h1 class="text-3xl font-bold">
      しりとり散歩中
    </h1>
  </header>

  <div class="mx-auto w-full max-w-3xl px-6 py-8">
    <%= render "word_chain_walks/active/count", word_chain_walk_steps: word_chain_walk_steps %>
    <%= render "word_chain_walks/active/target", word_chain_walk: word_chain_walk %>
    <%= render "word_chain_walks/active/form", word_chain_walk: word_chain_walk, word_chain_walk_step: word_chain_walk_step %>

    <section class="mx-auto mt-6 max-w-xl">
      <h2 class="text-base font-bold text-gray-900">
        <i class="fa-regular fa-clock"></i>
        直前の記録
      </h2>

      <%= render "word_chain_walks/active/latest_step", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>
    </section>

    <section class="mt-5 text-center">
      <div class="mt-6 text-center">
        <%= form_with  model: word_chain_walk, url: word_chain_walk_completion_path(word_chain_walk), method: :patch, data: { controller: "form", action: "geolocation:geolocation-fetched->form#submit" } do |form| %>
        <div data-controller="geolocation" class="mt-4">
          <%= form.hidden_field :finish_latitude, data: { geolocation_target: "latitude" } %>
          <%= form.hidden_field :finish_longitude, data: { geolocation_target: "longitude" } %>
          <%= button_tag "しりとり散歩をおしまいにする", type: "button", class: "text-sm text-gray-500 underline underline-offset-4 hover:text-gray-700", data: { action: "click->form#finishConfirm click->geolocation#fetchPositionAndSubmit"} %>
        </div>
      <% end %>
    </section>
  </div>
</div>
