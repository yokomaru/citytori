<div class="md:w-2/3 w-full">
  <div id="flash_messages">
    <%= render "shared/flash_messages" %>
  </div>

  <div id="word_chain_walk_errors">
    <%= render "shared/error_messages", object: word_chain_walk_step %>
  </div>

  <h1 class="font-bold text-4xl mb-6">しりとり散歩中</h1>

  <div class="mb-6">
    <%= render "word_chain_walks/active/target", word_chain_walk: word_chain_walk %>
    <%= render "word_chain_walks/active/form", word_chain_walk: word_chain_walk, word_chain_walk_step: word_chain_walk_step%>
    <%= render "word_chain_walks/active/steps", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>

  <section class="mt-5 text-center">
    <div>
      <%= button_to "散歩を完了する", word_chain_walk_completion_path(word_chain_walk), method: :patch, class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 fo cursor-pointer", data: { turbo_confirm: "散歩を完了しますか？" } %>
    </div>

    <div class="mt-6">
      <%= link_to "一覧へ戻る", word_chain_walks_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    </div>
  </section>
</div>
