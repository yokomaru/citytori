<div>
  <div>
    <%= link_to root_path, class: "text-sm text-gray-500" do %>
      <span>< ホームへ戻る</span>
    <% end %>
  </div>

  <h1 class="font-bold text-4xl mb-6">
    <%= @word_chain_walk.start_char %>から始まったしりとり散歩
  </h1>

  <div class="grid grid-cols-2 gap-6 py-6">
    <div class="flex items-start gap-3">
      <div class="mt-1">
        <i class="fa-regular fa-clock"></i>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-700">
          かかった時間
        </p>

        <p class="mt-1 text-xl font-semibold text-gray-900">
          <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
        </p>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <div class="mt-1">
        <i class="fa-solid fa-person-walking"></i>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-700">
          つなげた文字の数
        </p>

        <p class="mt-1 text-xl font-semibold text-gray-900">
          <%= word_chain_walk_steps.size %>回
        </p>
      </div>
    </div>
  </div>

  <div class="flex justify-end pb-4">
    <%= button_to "この散歩を削除する",
                  word_chain_walk_path(word_chain_walk),
                  method: :delete,
                  class: "text-sm text-gray-400 underline underline-offset-4 hover:text-red-500",
                  data: { turbo_confirm: "この散歩の記録を削除しますか？" } %>
  </div>
</div>
