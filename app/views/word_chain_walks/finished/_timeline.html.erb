<div class="mt-7">
  <div class="relative">
    <div class="absolute bottom-12 left-4 top-4 w-px bg-[#204D49]/25"></div>

    <div class="relative flex items-start gap-4 pb-6">
      <div class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#204D49] text-white">
        <i class="fa-solid fa-flag text-xs" aria-hidden="true"></i>
      </div>

      <div class="min-w-0 pt-1">
        <p class="text-xs font-bold tracking-[0.08em] text-[#204D49]">START</p>
        <p class="mt-1 text-sm text-[#303B3C]"><%= l(word_chain_walk.started_at, format: :long) %></p>
        <p class="mt-1 text-sm font-medium text-[#204D49]">「<%= word_chain_walk.start_char %>」からスタート</p>
      </div>
    </div>

    <div id="word_chain_walk_steps" class="space-y-4">
      <% if word_chain_walk_steps.any? %>
        <% word_chain_walk_steps.each do |word_chain_walk_step| %>
          <div class="relative flex items-center gap-4">
            <div class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center">
              <span class="h-3 w-3 rounded-full bg-[#FFF3DF] text-[#F16B36] ring-1 ring-[#F16B36]/20"></span>
            </div>

            <%= link_to(
                  word_chain_walk_word_chain_walk_step_path(
                    word_chain_walk,
                    word_chain_walk_step
                  ),
                  data: { turbo_frame: "_top" },
                  class: "flex min-w-0 flex-1 items-start gap-3 rounded-xl border border-[#C9DBD7] bg-white p-3 transition-colors hover:border-[#204D49]/35 hover:bg-[#FCF9EF] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49] sm:gap-4 sm:p-4"
                ) do %>
              <%= image_tag(
                    word_chain_walk_step.image.variant(resize_to_fill: [240, 180]),
                    alt: "「#{word_chain_walk_step.word}」の写真",
                    class: "h-24 w-24 shrink-0 rounded-lg object-cover sm:h-28 sm:w-28"
                  ) %>

              <div class="min-w-0 flex-1 pt-0.5">
                <p class="break-words text-lg font-bold leading-tight text-[#204D49] sm:text-xl">
                  <%= word_chain_walk_step.word %>
                </p>

                <p class="mt-2 text-xs text-[#303B3C]">
                  <%= l(word_chain_walk_step.created_at, format: :time_only) %>
                </p>

                <% if word_chain_walk_step.memo.present? %>
                  <p class="mt-2 truncate text-sm leading-relaxed text-[#303B3C]">
                    <%= word_chain_walk_step.memo %>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="relative flex items-center gap-4 py-2">
          <div class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center">
            <span class="h-3 w-3 rounded-full bg-[#FFF3DF] ring-1 ring-[#204D49]/20"></span>
          </div>
          <p class="text-sm text-[#52645F]">今回はことばの記録はありません</p>
        </div>
      <% end %>
    </div>

    <div class="relative flex items-start gap-4 pt-6">
      <div class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F16B36] text-white">
        <i class="fa-solid fa-flag-checkered text-xs" aria-hidden="true"></i>
      </div>

      <div class="min-w-0 pt-1">
        <p class="text-xs font-bold tracking-[0.08em] text-[#F16B36]">GOAL</p>
        <% if word_chain_walk.finished_at.present? %>
          <p class="mt-1 text-sm text-[#303B3C]"><%= l(word_chain_walk.finished_at, format: :long) %></p>
        <% end %>
        <p class="mt-1 text-sm font-medium text-[#204D49]">しりとり散歩完了</p>
      </div>
    </div>
  </div>
</div>
