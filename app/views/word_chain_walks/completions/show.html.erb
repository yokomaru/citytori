<div>
  <h1 class="font-bold text-4xl">
    <%= t("messages.word_chain_walk_completed") %>
  </h1>

  <p>見つけたワードの数: <%= @word_chain_walk.word_chain_walk_steps.size %></p>
  <p>開始日時: <%= @word_chain_walk.started_at.strftime("%Y/%m/%d %H:%M") %></p>
  <p>完了日時: <%= @word_chain_walk.finished_at.strftime("%Y/%m/%d %H:%M") %></p>
  <p>かかった時間: <%= formatted_elapsed_time(@word_chain_walk.elapsed_seconds) %></p>

  <%= link_to (t "defaults.show"), word_chain_walk_path(@word_chain_walk), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to (t "defaults.back"), word_chain_walks_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
