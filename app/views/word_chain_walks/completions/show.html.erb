<% set_meta_tags title: "しりとり散歩が完了しました", description: "今日の散歩で見つけた写真とことばを振り返れます。", noindex: true %> <%# herb:disable erb-no-unused-expressions %>

<article class="completion-page">
  <div class="completion-sheet">
    <header class="text-center">
      <%= image_tag "completion.png", alt: "", class: "completion-illustration" %>
      <h1 class="mt-3 text-2xl font-bold leading-snug text-[#204D49] sm:text-3xl">散歩、おつかれさまでした！</h1>
      <p class="mt-3 text-base text-[#303B3C]">
        <% if @word_chain_walk_steps.empty? %>
          今回は記録がありません。また気軽に出かけてみましょう。
        <% else %>
          <%= @word_chain_walk_steps.size %>個のことばを記録しました。
        <% end %>
      </p>
      <% if @last_step&.normalize_last_char == "ん" %>
        <p class="mt-2 text-sm text-[#52645F]">「ん」で終わることばを見つけて、散歩が終わりました。</p>
      <% end %>
    </header>

    <% photos = @word_chain_walk_steps.select { |step| step.image.attached? }.first(3) %>
    <% if photos.any? %>
      <section class="mt-6" aria-labelledby="walk-photos-heading">
        <h2 id="walk-photos-heading" class="flex items-center gap-2 text-xl font-bold text-[#204D49]">
          <span class="material-symbols-outlined" aria-hidden="true">search</span>
          今日の発見
        </h2>
        <div class="completion-photo-grid <%= { 1 => "completion-photo-grid--one", 2 => "completion-photo-grid--two", 3 => "completion-photo-grid--three" }.fetch(photos.size) %>">
          <% photos.each do |step| %>
            <%= link_to word_chain_walk_word_chain_walk_step_path(@word_chain_walk, step), class: "min-w-0 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#204D49]" do %>
              <%= image_tag step.image.variant(resize_to_limit: [600, 600]), alt: "「#{step.word}」の写真", class: "aspect-[4/3] w-full rounded-xl object-cover" %>
              <p class="mt-2 break-words text-base font-bold text-[#204D49]"><%= step.word %></p>
            <% end %>
          <% end %>
        </div>
        <% if @word_chain_walk_steps.size > 3 %>
          <p class="mt-3 text-sm text-[#52645F]">
            最初の3件を表示しています。
            <%= link_to "すべての記録は「今回の散歩を振り返る」から見られます。", word_chain_walk_path(@word_chain_walk), class: "text-[#204D49] underline underline-offset-4" %>
          </p>
        <% end %>
      </section>
    <% end %>

    <dl class="completion-stats">
      <div><dt class="text-sm">最初の文字</dt><dd class="mt-1 text-lg font-bold"><%= @word_chain_walk.start_char %></dd></div>
      <div><dt class="text-sm">つないだことば</dt><dd class="mt-1 text-lg font-bold"><%= @word_chain_walk_steps.size %>個</dd></div>
      <div><dt class="text-sm">かかった時間</dt><dd class="mt-1 text-lg font-bold"><%= formatted_elapsed_time(@word_chain_walk.elapsed_seconds) %></dd></div>
    </dl>

    <% if @word_chain_walk_steps.size > 1 %>
      <p class="mt-5 break-words text-center text-base text-[#303B3C]">「<%= @first_step.word %>」から「<%= @last_step.word %>」まで、ことばがつながりました。</p>
    <% end %>
    <footer class="mt-7 flex flex-col items-center text-center">
      <%= link_to "今回の散歩を振り返る", word_chain_walk_path(@word_chain_walk), class: "completion-primary-cta" %>
      <%= link_to "ホームに戻る", root_path, class: "mt-3 inline-flex min-h-11 items-center px-4 text-[#204D49] underline underline-offset-4" %>
    </footer>
  </div>
</article>
