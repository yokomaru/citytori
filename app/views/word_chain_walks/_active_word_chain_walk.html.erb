<div id="<%= dom_id word_chain_walk %>" class="p-4">
  <div class="mx-auto max-w-2xl">
    <h2 class="mb-4 text-xl font-bold">
      進行中の散歩
    </h2>

    <% latest_step = word_chain_walk.latest_step %>

    <div class="rounded-xl border border-gray-200 p-4">
      <p class="text-sm">
        <%= l word_chain_walk.started_at, format: :short %>
      </p>

      <div class="mt-4 flex gap-4 md:gap-6">
        <div class="flex w-1/3 items-center">
          <% if latest_step&.image&.attached? %>
            <%= image_tag latest_step.image,
                          class: "aspect-square w-full rounded-md object-cover" %>
          <% else %>
            <div
              class="
                flex aspect-square w-full items-center justify-center
                bg-gray-100
              "
            >
              No Image
            </div>
          <% end %>
        </div>

        <div class="w-2/3">
          <div class="mt-3">
            <p class="text-sm">探している文字</p>

            <p class="text-3xl font-bold">
              <%= word_chain_walk.target_char %>
            </p>
          </div>

          <div class="mt-4 flex gap-3">
            <div class="md:w-1/2">
              <p class="whitespace-nowrap text-xs md:text-sm">
                つないだ数
              </p>

              <p class="whitespace-nowrap text-sm font-bold md:text-base">
                <%= word_chain_walk.word_chain_walk_steps.size %>個
              </p>
            </div>

            <div class="md:w-1/2">
              <p class="whitespace-nowrap text-xs md:text-sm">
                経過時間
              </p>

              <p class="whitespace-nowrap text-sm font-bold md:text-base">
                <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <% if latest_step %>
        <div class="mt-2 pt-4 text-center md:mt-3">
          <p class="text-sm">前回見つけた言葉</p>

          <p class="font-bold">
            <%= latest_step.word %>
          </p>
        </div>
      <% end %>

      <div class="mt-4">
        <%= link_to "続きから歩く",
                    word_chain_walk,
                    class: "block w-full rounded-md bg-blue-600 py-3 text-center text-white" %>
      </div>
    </div>
  </div>
</div>
