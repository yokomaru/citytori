<div id="<%= dom_id word_chain_walk %>" class="p-6">
  <h2 class="mb-6 text-xl font-bold">
    進行中の散歩
  </h2>

  <div class="mx-auto max-w-2xl md:flex md:items-center">
    <% latest_step = word_chain_walk.latest_step %>

    <div class="mb-6">
      <% if latest_step&.image&.attached? %>
        <%= image_tag latest_step.image,
                      class: "mx-auto h-auto w-full max-w-56 rounded-md object-cover" %>
      <% else %>
        <div
          class="
            flex aspect-square w-full max-w-56 items-center justify-center
            rounded-md bg-gray-100 text-sm text-gray-500
          "
        >
          No Image
        </div>
      <% end %>
    </div>

    <div class="space-y-5 md:w-3/5">
      <p>
        <%= l word_chain_walk.started_at, format: :short %> 開始
      </p>

      <div>
        <p>現在</p>

        <p class="text-2xl font-bold">
          「<%= word_chain_walk.target_char %>」を
          <br>
          探しています
        </p>
      </div>

      <div class="flex gap-10">
        <div>
          <p>見つけた文字</p>

          <p>
            <%= word_chain_walk.word_chain_walk_steps.size %>個
          </p>
        </div>

        <div>
          <p>経過時間</p>

          <p>
            <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
          </p>
        </div>
      </div>

      <% if word_chain_walk.word_chain_walk_steps.any? %>
        <div>
          <p>
            直前に見つけた文字: <%= word_chain_walk.latest_step.word %>
          </p>
        </div>
      <% end %>

      <div>
        <%= link_to "続きから歩く", word_chain_walk, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      </div>
    </div>
  </div>
</div>
