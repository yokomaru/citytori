<% latest_step = word_chain_walk.word_chain_walk_steps.max_by(&:id) %>

<div id="<%= dom_id word_chain_walk %>" class="home-primary">
  <div class="home-content home-active-card">
    <h1 class="home-eyebrow">しりとり散歩中</h1>

    <section class="home-target" aria-labelledby="target-char-label">
      <h2 id="target-char-label">次にさがす文字</h2>
      <p class="home-target-char"><%= word_chain_walk.target_char %></p>

      <p class="home-connected-count">
        つないだことばの数 <%= word_chain_walk.word_chain_walk_steps.size %>個
      </p>
    </section>

    <% if latest_step %>
      <section class="home-latest-step" aria-labelledby="latest-step-label">
        <%= image_tag latest_step.image.variant(resize_to_fill: [240, 180]),
                      alt: "前回見つけた「#{latest_step.word}」の写真",
                      class: "home-latest-step-image" %>

        <div>
          <h2 id="latest-step-label" class="home-meta-label">前回見つけたことば</h2>
          <p class="home-latest-word"><%= latest_step.word %></p>
        </div>
      </section>
    <% else %>
      <p class="home-first-word-note">
        最初の「<%= word_chain_walk.target_char %>」を見つけにいこう。
      </p>
    <% end %>

    <%= link_to "続きから歩く", word_chain_walk, class: "home-primary-cta" %>
  </div>
</div>
