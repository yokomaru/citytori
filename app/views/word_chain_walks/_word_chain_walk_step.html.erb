<div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
  <div>
    <%= link_to word_chain_walk_step.word,
                word_chain_walk_word_chain_walk_step_path(word_chain_walk, word_chain_walk_step),
                class: "text-blue-500 hover:underline" %>

    <% if word_chain_walk_step.memo.present? %>
      <p class="mt-2 text-gray-600">
        <%= word_chain_walk_step.memo %>
      </p>
    <% end %>
  </div>

  <% if word_chain_walk_step.image.attached? %>
    <%= image_tag word_chain_walk_step.image.variant(resize_to_limit: [200, 200]) %>
  <% end %>

  <% if !word_chain_walk.finished? && word_chain_walk_step == word_chain_walk.latest_step %>
    <%= button_to "最新Stepを削除する",
                  latest_word_chain_walk_word_chain_walk_steps_path(word_chain_walk),
                  method: :delete,
                  class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer",
                  data: { turbo_confirm: "最新Stepを削除しますか？" } %>
  <% end %>
</div>