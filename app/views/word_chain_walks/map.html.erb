<% set_meta_tags title: "しりとり散歩の地図", description: "Citytoriで記録したしりとり散歩の位置情報を地図で振り返れます。", noindex: true %>

<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
  <%= render "word_chain_walks/finished/summary", word_chain_walk: @word_chain_walk, word_chain_walk_steps: @word_chain_walk_steps %>

  <%= turbo_frame_tag "finished_walk_view" do %>
    <%= render "word_chain_walks/finished/tabs", word_chain_walk: @word_chain_walk, active_tab: :map %>

    <%= render "word_chain_walks/finished/map", word_chain_walk_steps: @word_chain_walk_steps, locations: @locations %>
  <% end %>

  <div class="mt-12 border-t border-[#C9DBD7] pt-6 text-center">
    <%= link_to "この散歩を削除する",
                word_chain_walk_path(@word_chain_walk),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "この散歩を削除しますか？"
                },
                class: "text-sm text-[#52645F] underline hover:text-red-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" %>
  </div>
</div>
