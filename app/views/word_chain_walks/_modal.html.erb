<dialog
  data-modal-target="modal"
  class="
    fixed inset-0 size-auto max-h-none max-w-none bg-transparent p-0
    backdrop:bg-black/70
  "
>
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-lg bg-white p-6 shadow-xl">
      <%= render "word_chain_walks/modal_target", word_chain_walk: word_chain_walk %>

      <%= render "word_chain_walk_steps/form",
                 form: form,
                 word_chain_walk: word_chain_walk,
                 word_chain_walk_step: word_chain_walk_step %>

      <button
        type="button"
        data-action="modal#close"
        class="mt-4 rounded border px-4 py-2"
      >
        キャンセル
      </button>
    </div>
  </div>
</dialog>
