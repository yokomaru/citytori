<div id="latest_step">
  <% if word_chain_walk.latest_step.present? %>
    <% latest_step = word_chain_walk.latest_step %>
    <div class="mt-2 rounded-2xl border border-gray-300 bg-white px-4 py-4">
      <div class="flex items-center gap-3">
        <div
          class="
            flex h-12 w-12 shrink-0 items-center justify-center rounded-full
            border-2 border-blue-600 text-xl font-bold text-blue-700
          "
        >
          <%= latest_step.normalize_first_char %>
        </div>

        <div class="min-w-0 flex-1">
          <%= link_to latest_step.word,
                      word_chain_walk_word_chain_walk_step_path(word_chain_walk, latest_step),
                      class: "break-words text-lg font-bold text-gray-900 hover:underline" %>

          <% if latest_step.memo.present? %>
            <p class="mt-1 text-sm text-gray-500">
              <%= latest_step.memo %>
            </p>
          <% end %>
        </div>
      </div>

      <div class="mt-3 border-t border-gray-100 pt-2 text-right">
        <%= button_to "直前の記録を取り消す",
                      latest_word_chain_walk_word_chain_walk_steps_path(word_chain_walk),
                      method: :delete,
                      class: "text-xs text-gray-400 underline underline-offset-4 hover:text-gray-600",
                      data: { turbo_confirm: "登録した言葉を取り消しますか？" } %>
      </div>
    </div>
  <% else %>
    <p class="mt-3 text-center text-sm text-gray-500">
      まだ言葉を見つけていません。
    </p>
  <% end %>
</div>
