<dialog
  data-modal-target="modal"
  aria-labelledby="record-dialog-title"
  data-action="cancel->modal#cancel"
  class="fixed inset-0 size-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-[#303B3C]/60"
>
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative max-h-[calc(100dvh-2rem)] w-full max-w-2xl overflow-y-auto rounded-2xl border border-[#204D49]/10 bg-white p-5 shadow-sm sm:p-8">
      <button
        type="button"
        data-action="modal#close"
        aria-label="閉じる"
        class="absolute right-3 top-3 grid size-11 place-items-center rounded-full text-2xl leading-none text-[#52645F] hover:bg-[#E8F4F5] hover:text-[#204D49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]"
      >
        ×
      </button>

      <%= render "word_chain_walks/active/modal_target", word_chain_walk: word_chain_walk %>

      <%= render "word_chain_walk_steps/form",
                 form: form,
                 word_chain_walk: word_chain_walk,
                 word_chain_walk_step: word_chain_walk_step %>
    </div>
  </div>
</dialog>
