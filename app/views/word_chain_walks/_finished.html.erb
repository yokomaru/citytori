<div class="md:w-2/3 w-full">
  <%= render "word_chain_walks/finished/summary", word_chain_walk: @word_chain_walk, word_chain_walk_steps: @word_chain_walk_steps %>

  <%= turbo_frame_tag "finished_walk_view" do %>
    <div class="inline-flex w-full items-center rounded-lg bg-gray-100 p-1">
      <%= link_to "タイムライン", word_chain_walk_path(word_chain_walk), data: { turbo_frame: "finished_walk_view" } , class: "w-full rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 shadow-sm" %>
      <%= link_to "地図", map_word_chain_walk_path(word_chain_walk), data: { turbo_frame: "finished_walk_view" } , class: "w-full rounded-md bg-transparent px-3 py-2 text-center text-sm font-semibold text-gray-500" %>
    </div>

    <%= render "word_chain_walks/finished/timeline", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>
  <% end %>
</div>
