<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
  <%= render "word_chain_walks/finished/summary", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>

  <%= turbo_frame_tag "finished_walk_view" do %>
    <% if word_chain_walk_steps.any? { |step| step.latitude.present? && step.longitude.present? } %>
      <nav class="walk-view-tabs mt-5 grid w-full grid-cols-2 overflow-hidden rounded-xl border border-[#C9DBD7] bg-[#F2F5F3]" aria-label="散歩の表示切り替え">
        <%= link_to "記録", word_chain_walk_path(word_chain_walk),
                    data: { turbo_frame: "finished_walk_view" },
                    aria: { current: "page" },
                    class: "walk-view-tab-active relative flex min-h-11 items-center justify-center bg-white px-3 text-center text-sm font-semibold text-[#204D49] shadow-[0_1px_2px_rgba(32,77,73,0.08)] focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#204D49]" %>

        <%= link_to "地図", map_word_chain_walk_path(word_chain_walk),
                    data: { turbo_frame: "finished_walk_view" },
                    class: "flex min-h-11 items-center justify-center px-3 text-center text-sm font-medium text-[#303B3C] transition-colors hover:bg-white/60 hover:text-[#204D49] focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#204D49]" %>
      </nav>
    <% end %>
    <%= render "word_chain_walks/finished/timeline", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to word_chain_walks_path,
                class: "walk-history-button" do %>
      <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
      <span>これまでの散歩を見る</span>
    <% end %>
  </div>

  <div class="mt-4 pt-6 pb-8 text-right">
    <%= button_to word_chain_walk_path(word_chain_walk),
                method: :delete,
                data: {
                  turbo_confirm: "この散歩を削除しますか？"
                },
                class: "walk-delete-button inline-flex items-center gap-2 text-sm text-[#52645F] hover:text-red-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" do %>
      <span class="material-symbols-outlined" aria-hidden="true">delete</span>
      <span class="underline">この散歩を削除する</span>
    <% end %>
  </div>
</div>
