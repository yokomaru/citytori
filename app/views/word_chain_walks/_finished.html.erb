<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl mb-6"></h1>

  <div>
    <h2 class="font-bold text-2xl mb-4">タイムライン</h2>

    <div
      id="word_chain_walk_steps"
      class="min-w-full divide-y divide-gray-200 space-y-5"
    >
      <% if word_chain_walk_steps.any? %>
        <% latest_step_id = word_chain_walk.latest_step.id %>
        <% word_chain_walk_steps.each do |word_chain_walk_step| %>
          <%= render "word_chain_walk_step", word_chain_walk: word_chain_walk, word_chain_walk_step: word_chain_walk_step, latest_step_id: latest_step_id %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if locations.present? %>
    <div
      id="walk-map-container"
      data-controller="walk-map"
      data-walk-map-positions-value="<%= locations.to_json %>"
    >
      <div
        data-walk-map-target="placeholder"
        style="height: 500px; width: 100%;"
      ></div>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "一覧へ戻る", word_chain_walks_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
