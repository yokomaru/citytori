<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl mb-6">
    <%= word_chain_walk.start_char %>から始まったしりとり散歩の履歴
  </h1>

  <%= render "word_chain_walks/finished/timeline", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>
  <%= render "word_chain_walks/finished/map", locations: locations %>

  <div class="mt-6">
    <%= link_to "しりとり散歩の一覧へ戻る", word_chain_walks_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
