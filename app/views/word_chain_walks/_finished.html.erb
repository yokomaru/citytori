<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
  <%= render "word_chain_walks/finished/summary", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>

  <%= turbo_frame_tag "finished_walk_view" do %>
    <% if word_chain_walk_steps.any? { |step| step.latitude.present? && step.longitude.present? } %>
      <%= render "word_chain_walks/finished/tabs", word_chain_walk: word_chain_walk, active_tab: :timeline %>
    <% end %>

    <%= render "word_chain_walks/finished/timeline", word_chain_walk: word_chain_walk, word_chain_walk_steps: word_chain_walk_steps %>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to word_chain_walks_path,
                class: "walk-history-button" do %>
      <span class="material-symbols-outlined" aria-hidden="true">
        chevron_left
      </span>

      <span>これまでの散歩を見る</span>
    <% end %>
  </div>

  <div class="mt-4 pt-6 pb-8 text-right">
    <%= button_to word_chain_walk_path(word_chain_walk),
                method: :delete,
                data: {
                  turbo_confirm: "この散歩を削除しますか？"
                },
                class: "walk-delete-button inline-flex items-center gap-2 text-sm text-[#52645F] hover:text-red-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" do %>
      <span class="material-symbols-outlined" aria-hidden="true">delete</span>
      <span class="underline">この散歩を削除する</span>
    <% end %>
  </div>
</div>
