<div class="mx-auto w-full max-w-2xl px-4">
  <div class="rounded-xl border border-gray-200 p-6 sm:p-8 md:p-10">
    <div class="text-center">
      <div class="mx-auto max-w-xs md:max-w-64">
        <%= image_tag "citytori-start.png", class: "h-auto w-full" %>
      </div>

      <h2 class="mt-8 text-2xl font-bold text-gray-900 sm:text-3xl">
        しりとり散歩を始めよう
      </h2>

      <p class="mt-4 text-sm sm:text-base">
        街を歩いて、言葉を見つけてみよう！
      </p>

      <div class="mt-6 flex justify-center">
        <%= button_to "始める",
                      word_chain_walks_path,
                      method: :post,
                      class: "rounded-md bg-blue-600 px-10 py-4 text-lg font-medium text-white hover:bg-blue-500" %>
      </div>
    </div>
  </div>
</div>
