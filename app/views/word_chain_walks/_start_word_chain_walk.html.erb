<div class="px-4">
  <div class="rounded-xl border border-gray-200 p-8">
    <div class="text-center">
      <div class="mx-auto max-w-xs md:max-w-64">
        <%= image_tag "citytori-start.png", class: "h-auto w-full" %>
      </div>

      <h2 class="text-xl font-bold text-gray-900">
        しりとり散歩を始めよう
      </h2>

      <p class="mt-2">
        街を歩いて、言葉を見つけてみよう！
      </p>

      <div class="flex justify-center">
        <%= button_to "始める",
                      word_chain_walks_path,
                      method: :post,
                      class: "block rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
      </div>
    </div>
  </div>
</div>
