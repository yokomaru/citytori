<div data-controller="<%= "walk-start" unless local_assigns[:shared_start_controller] %>">
  <div class="home-primary">
    <section
      class="home-content home-start-card"
      aria-labelledby="start-walk-title"
    >

      <h1 id="start-walk-title"><span class="inline-block">しりとり散歩に</span><span class="inline-block">出かけよう</span></h1>

      <p class="home-start-description">
        街で見つけたものを、<br class="mobile-copy-break">写真とことばでつないでいこう。
      </p>

      <%= button_tag "しりとり散歩をはじめる", type: "button", class: "home-primary-cta walk-start-cta", data: { action: "walk-start#open"} %>

      <p class="home-location-note">
        位置情報は任意です。<br class="mobile-copy-break">写真とことばだけでも楽しめます。
      </p>
    </section>
  </div>

  <%= render "word_chain_walks/start_modal" %>
</div>
