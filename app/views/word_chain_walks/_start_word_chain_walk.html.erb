<div class="mx-auto max-w-2xl px-4">
  <div class="rounded-xl border border-gray-200 p-4 sm:p-6 md:p-8">
    <div class="text-center">
      <div class="mx-auto max-w-56 md:max-w-64">
        <%= image_tag "citytori-start.png", class: "w-full" %>
      </div>

      <h2 class="mt-6 text-2xl font-bold sm:text-3xl">
        しりとり散歩を始めよう
      </h2>

      <p class="mt-3 text-sm sm:text-base">
        街を歩いて、言葉を見つけてみよう！
      </p>

      <%= form_with model: word_chain_walk, data: { controller: "form", action: "geolocation:geolocation-fetched->form#submit" } do |form| %>
        <div data-controller="geolocation" class="mt-4">
          <%= form.hidden_field :start_latitude, data: { geolocation_target: "latitude" } %>
          <%= form.hidden_field :start_longitude, data: { geolocation_target: "longitude" } %>
          <%= button_tag "始める", type: "button", class: "rounded-md bg-blue-600 px-10 py-3 text-lg text-white", data: { action: "click->geolocation#fetchPositionAndSubmit" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
