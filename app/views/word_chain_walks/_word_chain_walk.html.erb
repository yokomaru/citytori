<div id="<%= dom_id word_chain_walk %>" class="mx-auto max-w-2xl py-2">
  <% latest_step = word_chain_walk.latest_step %>

  <%= link_to word_chain_walk, class: "block rounded-md border border-gray-200 p-4" do %>
    <p class="text-sm">
      <%= l word_chain_walk.started_at, format: :short %>
    </p>

    <div class="mt-4 flex gap-4 md:gap-6">
      <div class="flex w-1/4 items-center">
        <% if latest_step&.image&.attached? %>
          <%= image_tag latest_step.image, class: "aspect-square w-full rounded-md object-cover" %>
        <% else %>
          <div
            class="
              flex aspect-square w-full items-center justify-center
              bg-gray-100
            "
          >
            No Image
          </div>
        <% end %>
      </div>

      <div class="w-2/3">
        <div class="mt-3">
          <p class="text-sm">探している文字</p>

          <p class="text-3xl font-bold">
            <%= word_chain_walk.target_char %>
          </p>
        </div>

        <div class="mt-4 flex gap-3">
          <div class="md:w-1/2">
            <p class="whitespace-nowrap text-xs md:text-sm">
              つないだ数
            </p>

            <p class="whitespace-nowrap text-sm font-bold md:text-base">
              <%= word_chain_walk.word_chain_walk_steps.size %>個
            </p>
          </div>

          <div class="md:w-1/2">
            <p class="whitespace-nowrap text-xs md:text-sm">
              経過時間
            </p>

            <p class="whitespace-nowrap text-sm font-bold md:text-base">
              <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
