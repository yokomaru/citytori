<% latest_step = word_chain_walk.word_chain_walk_steps.max_by(&:id) %>

<article id="<%= dom_id word_chain_walk %>" aria-labelledby="<%= dom_id(word_chain_walk, :title) %>">
  <%= link_to word_chain_walk, class: "home-recent-card" do %>
    <span class="home-recent-start-char">「<%= word_chain_walk.start_char %>」から</span>
    <% if latest_step %>
      <%= image_tag latest_step.image.variant(resize_to_fill: [240, 180]),
                    alt: "「#{word_chain_walk.start_char}」から始まった散歩の写真",
                    class: "home-recent-image" %>
    <% else %>
      <div
        class="home-recent-image home-recent-no-image"
        role="img"
        aria-label="写真はありません。"
      >
        写真はまだありません。
      </div>
    <% end %>

    <div class="home-recent-card-body">
      <h3 id="<%= dom_id(word_chain_walk, :title) %>" class="home-recent-word">
        <time datetime="<%= word_chain_walk.started_at.iso8601 %>"><%= word_chain_walk.started_at.strftime("%Y年%-m月%-d日 %H:%M") %></time>の散歩
      </h3>
    </div>

    <dl class="home-recent-stats">
      <div>
        <dt>ことば</dt>

        <dd>
          <%= word_chain_walk.word_chain_walk_steps.size %>個
        </dd>
      </div>

      <div>
        <dt>時間</dt>

        <dd>
          <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
        </dd>
      </div>
    </dl>
  <% end %>
</article>
