<div id="<%= dom_id word_chain_walk %>" class="mx-auto max-w-2xl py-1">
  <%= link_to word_chain_walk, class: "block rounded-md border border-gray-200 p-4" do %>
    <p class="text-sm">
      <%= l word_chain_walk.finished_at, format: :short %>
    </p>

    <div class="mt-2 text-center">
      <p class="text-base font-bold">
        「<%= word_chain_walk.start_char %>」からはじまった散歩
      </p>
    </div>
  <% end %>
</div>
