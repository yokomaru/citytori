<% content_for :title, "散歩中の画面" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice">
      <%= notice %>
    </p>
  <% end %>

  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block" id="alert">
      <%= alert %>
    </p>
  <% end %>

  <%= render 'shared/error_messages', object: @word_chain_walk_step %>

  <h1 class="font-bold text-4xl mb-6">しりとり散歩詳細</h1>

  <div class="space-y-2 mb-6">
    <p>
      開始文字:
      <%= @word_chain_walk.start_char %>
    </p>

    <p>
      現在探す文字:
      <%= @word_chain_walk.target_char %>
    </p>

    <p>
      開始日時:
      <%= @word_chain_walk.started_at.strftime("%Y/%m/%d %H:%M") %>
    </p>

    <p>
      状態:
      <%= @word_chain_walk.finished? ? "完了済み" : "進行中" %>
    </p>
  </div>

  <% unless @word_chain_walk.finished? %>
    <div class="mb-6">
      <p>
        <%= @word_chain_walk.target_char %> に続く言葉を街の中から見つけましょう
      </p>

      <div class="mt-4">
        <%= link_to "写真を撮る",
                    new_word_chain_walk_word_chain_walk_step_path(@word_chain_walk),
                    class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium" %>
      </div>
    </div>
  <% end %>

  <div>
    <h2 class="font-bold text-2xl mb-4">Step一覧</h2>

    <% if @word_chain_walk_steps.any? %>
      <div
        id="word_chain_walk_steps"
        class="min-w-full divide-y divide-gray-200 space-y-5"
      >
        <% @word_chain_walk_steps.each do |word_chain_walk_step| %>
          <%= render "word_chain_walk_step",
                     word_chain_walk: @word_chain_walk,
                     word_chain_walk_step: word_chain_walk_step %>
        <% end %>
      </div>
    <% else %>
      <p class="my-10 text-center">まだStepはありません。</p>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to "一覧へ戻る",
                word_chain_walks_path,
                class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>