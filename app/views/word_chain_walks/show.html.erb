<% content_for :title, "散歩中の画面" %>

<div class="md:w-2/3 w-full">
  <div id="flash_messages">
    <%= render "shared/flash_messages" %>
  </div>


  <%= render 'shared/error_messages', object: @word_chain_walk_step %>

  <h1 class="font-bold text-4xl mb-6">しりとり散歩詳細</h1>

  <div class="space-y-2 mb-6">
    <p>
      開始文字: <%= @word_chain_walk.start_char %>
    </p>

    <p>
      現在探す文字: <%= @word_chain_walk.target_char %>
    </p>

    <p>
      開始日時: <%= @word_chain_walk.started_at.strftime("%Y/%m/%d %H:%M") %>
    </p>

    <p>
      状態: <%= @word_chain_walk.finished? ? "完了済み" : "進行中" %>
    </p>
  </div>

  <% unless @word_chain_walk.finished? %>
    <div class="mb-6">
      <%= render "word_chain_walks/target", word_chain_walk: @word_chain_walk %>

      <div class="mt-4">
        <div data-controller="modal previews geolocation" data-action="modal:reset->previews#removeImage modal:reset->geolocation#removeGeolocationInfo">
          <button type="button" data-action="modal#open" class="rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium" >
            写真を撮る
          </button>

          <%= render "word_chain_walks/modal", word_chain_walk: @word_chain_walk, word_chain_walk_step: @word_chain_walk_step %>
        </div>
    </div>
  <% end %>

  <div>
    <h2 class="font-bold text-2xl mb-4">Step一覧</h2>
      <div
        id="word_chain_walk_steps"
        class="min-w-full divide-y divide-gray-200 space-y-5"
      >
        <% if @word_chain_walk_steps.any? %>
          <% latest_step_id = @word_chain_walk.latest_step.id %>
          <% @word_chain_walk_steps.each do |word_chain_walk_step| %>
            <%= render "word_chain_walk_step",
                        word_chain_walk: @word_chain_walk,
                        word_chain_walk_step: word_chain_walk_step,
                        latest_step_id: latest_step_id %>
          <% end %>
        <% else %>
          <p class="my-10 text-center">まだStepはありません。</p>
        <% end %>
      </div>
  </div>

  <% unless @word_chain_walk.finished? %>
    <div>
      <%= button_to "散歩を完了する",
                    word_chain_walk_completion_path(@word_chain_walk),
                    method: :patch,
                    class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer",
                    data: { turbo_confirm: "散歩を完了しますか？" } %>
    </div>
  <% else %>
    <% if @locations.present? %>
      <div
        id="walk-map-container"
        data-controller="walk-map"
        data-walk-map-positions-value="<%= @locations.to_json %>"
      >
        <div
          data-walk-map-target="placeholder"
          style="height: 500px; width: 100%;"
        ></div>
      </div>
    <% end %>
  <% end %>

  <div class="mt-6">
    <%= link_to "一覧へ戻る",
                word_chain_walks_path,
                class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
