<% content_for :title, "しりとり散歩" %>

<div class="w-full">
  <% if @word_chain_walk %>
    <section id="word_chain_walk_errors">
      <%= render "shared/error_messages", object: @word_chain_walk %>
    </section>
  <% end %>

  <section id="active_word_chain_walk">
    <% if @active_word_chain_walk.present? %>
      <%= render "word_chain_walks/active_word_chain_walk", word_chain_walk: @active_word_chain_walk %>
    <% else %>
      <%= render "word_chain_walks/start_word_chain_walk" %>
    <% end %>
  </section>

  <section id="finished_word_chain_walks" class="mb-4 px-4">
    <% if @finished_word_chain_walks.any? %>
      <div class="mx-auto max-w-2xl">
        <h2 class="mb-4 text-xl font-bold">
          直近のしりとり散歩
        </h2>

        <div id="word_chain_walks">
          <% @finished_word_chain_walks.each do |finished_word_chain_walk| %>
            <%= render "word_chain_walks/finished_word_chain_walk",
                      word_chain_walk: finished_word_chain_walk %>
          <% end %>
        </div>

        <% if current_user.word_chain_walks.finished.size > 3 %>
          <div class="mb-5 mt-2 text-center">
            <%= link_to "もっと見る", word_chain_walks_path, class: "text-sm text-gray-600" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">
        まだ散歩の記録はありません
      </p>
    <% end %>
  </section>
</div>
