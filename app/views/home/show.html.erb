<h1>Citytori</h1>

<% if logged_in? %>
  <p><%= current_user.name %> さん、ログイン中です。</p>

  <%= button_to "ログアウト", logout_path, method: :post %>
<% else %>
  <p>Googleアカウントでログインして、しりとり散歩を記録できます。</p>

  <%= button_to "Googleでログイン",
                "/auth/google_oauth2",
                method: :post,
                data: { turbo: false } %>
<% end %>