<% if current_user %>
  <% set_meta_tags title: "しりとり散歩", description: "Citytoriで、しりとり散歩の進行状況やこれまでの記録を確認できます。", noindex: true %> <%# herb:disable erb-no-unused-expressions %>
  <%= render "logged_in",
             active_word_chain_walk: @active_word_chain_walk,
             finished_word_chain_walks: @finished_word_chain_walks %>
<% else %>
  <% set_meta_tags description: "Citytoriは、街で見つけたものからしりとりをつなぎ、写真とことばを記録して振り返る散歩サービスです。" %> <%# herb:disable erb-no-unused-expressions %>
  <%= render "logged_out" %>
<% end %>
